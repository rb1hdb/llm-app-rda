{
  "foreign_keys": [
    {"source": "sinais.sinais[].defesas[]",                "target": "defesas.defesas[].id"},
    {"source": "recon.prompts[].sinal_alvo[]",             "target": "sinais.sinais[].id"},
    {"source": "tecnicas.tecnicas[].defesas_bypassadas[]", "target": "defesas.defesas[].id"},
    {"source": "evasoes.evasoes[].defesas_bypassadas[]",   "target": "defesas.defesas[].id"},
    {"source": "produtos.produtos[].defesas[]",            "target": "defesas.defesas[].id"},
    {"source": "*.fontes[].r",                             "target": "referencias.referencias[].id"}
  ],
  "constraints": [
    "fontes[].tipo must equal referencias[r].tipo",
    "recon.sinal_alvo[] must reference sinais with tipo=passivo",
    "tecnicas.defesas_bypassadas[] must not be empty",
    "evasoes.defesas_bypassadas[] must not be empty",
    "all ids unique within each file"
  ],
  "coverage": [
    "every sinal with tipo=passivo has at least one recon probe with matching sinal_alvo",
    "every defesa has at least one fraqueza"
  ],
  "enums": {
    "defesas.locus": ["input", "output", "prompt", "modelo", "acao", "processo"],
    "defesas.aplicabilidade": ["LLM", "RAG", "Agente", "MCP"],
    "sinais.tipo": ["passivo", "ativo"],
    "tecnicas.turno": ["single-turn", "multi-turn", "m2s"],
    "referencias.tipo": ["primaria", "survey", "operacional"],
    "recon.grupo": ["abertura", "arquitetura", "defesas"]
  }
}
