    {
      "t": "Resumo no Modelo 5W2H",
      "filhos": [
        {
          "t": "1. WHERE  (Vetor)     → ONDE posso por o payload?"
        },
        {
          "t": "2. WHAT   (Alvo)      → o QUE (qual componente) consigo alcançar por esse vetor?"
        },
        {
          "t": "3. WHY    (Objetivo)  → POR QUE vou atacar (que efeito quero produzir)?"
        },
        {
          "t": "4. HOW₁   (Técnica)   → COMO FORMULO o payload para esse efeito?"
        },
        {
          "t": "5. HOW₂   (Evasão) → COMO \"ESCONDO\" o ataque dos controles?"
        },
        {
          "t": "6. WHO    (Topologia) → QUEM ataca (tester, 1a LLM, 2a LLM, ...) (preciso de hops intermediários)?"
        },
        {
          "t": "7. WHEN   (Estágio na campanha) → QUANDO vou fazer este ataque (e.g., em qual estágio da campanha — promptware)?"
        }
      ]
    }
  ],
  "grupo_descricoes": {
    "instruction-override": "Técnicas que tentam sobrepor diretamente as instruções do sistema, seja por comando explícito, mascaramento ou fabricação de políticas.",
    "role-playing": "Exploram a capacidade do modelo de assumir personagens, cenários ou modos operacionais fabricados para contornar restrições.",
    "context-exploitation": "Manipulam o contexto da conversa — contexto falso, precedentes sintéticos, framing, virtualização — para induzir respostas proibidas.",
    "social-engineering": "Aplicam táticas de engenharia social (urgência, autoridade, emoção, incentivo, ameaça, bajulação) ao modelo.",
    "escalacao-gradual": "Ataques multi-turno que escalam gradualmente a severidade do pedido ao longo da conversa.",
    "compositional-packing": "Combinam múltiplas técnicas em um único payload composto (HOUYI, Russian Doll, etc.).",
    "conversational-packing": "Empacotam um diálogo multi-turn em um único prompt estruturado, convertendo os turnos em hífens, numeração ou código Python (M2S: Hyphenize, Numberize, Pythonize).",
    "agentic-mcp": "Técnicas específicas para sistemas agênticos: injeção em definições de ferramentas, rug pull, backdoor em arquivos, confused deputy, smuggling de parâmetros.",
    "manipulacao-de-raciocinio": "Exploram o processo de raciocínio do modelo (Chain-of-Thought spoofing, manipulação do modo de pensamento).",
    "memoria": "Exploram mecanismos de memória persistente do agente para inserir instruções que afetam sessões futuras.",
    "optimization-based": "Técnicas baseadas em otimização automática (GCG, adversarial suffixes) para gerar payloads que bypassam alinhamento.",
    "in-context-learning": "Exploram few-shot learning in-context para induzir o modelo a seguir padrões maliciosos de exemplo.",
    "priming-conversacional": "Estabelecem premissas ou padrões no início da conversa que condicionam respostas futuras do modelo.",
    "saturacao-de-contexto": "Inundam a janela de contexto com tokens repetidos ou conteúdo volumoso para diluir instruções de segurança."
  },
  "grupo_ordem": [
