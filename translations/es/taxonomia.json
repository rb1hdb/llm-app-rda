    {
      "t": "Resumen en el Modelo 5W2H",
      "filhos": [
        {
          "t": "1. WHERE  (Vector)     → ¿DÓNDE puedo colocar el payload?"
        },
        {
          "t": "2. WHAT   (Objetivo)   → ¿QUÉ (qué componente) puedo alcanzar por ese vector?"
        },
        {
          "t": "3. WHY    (Objetivo)   → ¿POR QUÉ voy a atacar (qué efecto quiero producir)?"
        },
        {
          "t": "4. HOW₁   (Técnica)    → ¿CÓMO FORMULO el payload para ese efecto?"
        },
        {
          "t": "5. HOW₂   (Evasión) → ¿CÓMO \"ESCONDO\" el ataque de los controles?"
        },
        {
          "t": "6. WHO    (Topología)  → ¿QUIÉN ataca (tester, 1er LLM, 2do LLM, ...) (necesito hops intermedios)?"
        },
        {
          "t": "7. WHEN   (Etapa en la campaña) → ¿CUÁNDO voy a hacer este ataque (p.ej., en qué etapa de la campaña — promptware)?"
        }
      ]
    }
  ],
  "grupo_descricoes": {
    "instruction-override": "Técnicas que intentan sobrescribir directamente las instrucciones del sistema, mediante comando explícito, enmascaramiento o fabricación de políticas.",
    "role-playing": "Explotan la capacidad del modelo de asumir personajes, escenarios o modos operativos fabricados para eludir restricciones.",
    "context-exploitation": "Manipulan el contexto de la conversación — contexto falso, precedentes sintéticos, framing, virtualización — para inducir respuestas prohibidas.",
    "social-engineering": "Aplican tácticas de ingeniería social (urgencia, autoridad, emoción, incentivo, amenaza, adulación) al modelo.",
    "escalacao-gradual": "Ataques multi-turno que escalan gradualmente la severidad de la solicitud a lo largo de la conversación.",
    "compositional-packing": "Combinan múltiples técnicas en un único payload compuesto (HOUYI, Russian Doll, etc.).",
    "conversational-packing": "Empaquetan un diálogo multi-turno en un único prompt estructurado, convirtiendo los turnos en guiones, numeración o código Python (M2S: Hyphenize, Numberize, Pythonize).",
    "agentic-mcp": "Técnicas específicas para sistemas agénticos: inyección en definiciones de herramientas, rug pull, backdoor en archivos, confused deputy, smuggling de parámetros.",
    "manipulacao-de-raciocinio": "Explotan el proceso de razonamiento del modelo (Chain-of-Thought spoofing, manipulación del modo de pensamiento).",
    "memoria": "Explotan mecanismos de memoria persistente del agente para insertar instrucciones que afectan sesiones futuras.",
    "optimization-based": "Técnicas basadas en optimización automática (GCG, sufijos adversariales) para generar payloads que eluden el alineamiento.",
    "in-context-learning": "Explotan el aprendizaje few-shot in-context para inducir al modelo a seguir patrones maliciosos de ejemplo.",
    "priming-conversacional": "Establecen premisas o patrones al inicio de la conversación que condicionan las respuestas posteriores del modelo.",
    "saturacao-de-contexto": "Inundan la ventana de contexto con tokens repetidos o contenido voluminoso para diluir las instrucciones de seguridad."
  },
  "grupo_ordem": [
