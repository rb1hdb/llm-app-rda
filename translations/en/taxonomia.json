  "grupo_descricoes": {
    "instruction-override": "Techniques that try to directly override the system instructions, through explicit command, masking or fabricated policies.",
    "role-playing": "Exploit the model's ability to adopt fabricated personas, scenarios or operating modes to get around restrictions.",
    "context-exploitation": "Manipulate the conversation context — false context, synthetic precedents, framing, virtualization — to induce forbidden responses.",
    "social-engineering": "Apply social-engineering tactics (urgency, authority, emotion, incentive, threat, flattery) to the model.",
    "escalacao-gradual": "Multi-turn attacks that gradually escalate the severity of the request over the conversation.",
    "compositional-packing": "Combine multiple techniques into a single composite payload (HOUYI, Russian Doll, etc.).",
    "conversational-packing": "Pack a multi-turn dialogue into a single structured prompt, converting the turns into hyphens, numbering or Python code (M2S: Hyphenize, Numberize, Pythonize).",
    "agentic-mcp": "Techniques specific to agentic systems: injection into tool definitions, rug pull, file backdoors, confused deputy, parameter smuggling.",
    "manipulacao-de-raciocinio": "Exploit the model's reasoning process (Chain-of-Thought spoofing, thinking-mode manipulation).",
    "memoria": "Exploit the agent's persistent memory mechanisms to insert instructions that affect future sessions.",
    "optimization-based": "Techniques based on automatic optimization (GCG, adversarial suffixes) to generate payloads that bypass alignment.",
    "in-context-learning": "Exploit in-context few-shot learning to make the model follow malicious example patterns.",
    "priming-conversacional": "Establish premises or patterns early in the conversation that condition the model's later responses.",
    "saturacao-de-contexto": "Flood the context window with repeated tokens or bulky content to dilute safety instructions."
  },
  "grupo_ordem": [
