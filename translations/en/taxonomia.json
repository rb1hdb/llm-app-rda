    {
      "t": "Summary in the 5W2H Model",
      "filhos": [
        {
          "t": "1. WHERE  (Vector)    → WHERE can I place the payload?"
        },
        {
          "t": "2. WHAT   (Target)    → WHAT (which component) can I reach through this vector?"
        },
        {
          "t": "3. WHY    (Objective) → WHY am I attacking (what effect do I want to produce)?"
        },
        {
          "t": "4. HOW₁   (Technique) → HOW do I CRAFT the payload for this effect?"
        },
        {
          "t": "5. HOW₂   (Evasion) → HOW do I HIDE the attack from controls?"
        },
        {
          "t": "6. WHO    (Topology)  → WHO attacks (tester, 1st LLM, 2nd LLM, ...) (do I need intermediate hops)?"
        },
        {
          "t": "7. WHEN   (Campaign stage) → WHEN will I execute this attack (e.g., at which stage of the campaign — promptware)?"
        }
      ]
    }
